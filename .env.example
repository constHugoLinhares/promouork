# =============================================================================
# PROMOÜORK - Variáveis de ambiente (fonte da verdade)
# Copie para .env e preencha os valores. Use .env.local ou .env.prod se quiser
# separar por ambiente.
# =============================================================================

# -----------------------------------------------------------------------------
# App Database (Postgres principal da aplicação)
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=promouork
DB_PORT=5432
# URL completa (local: postgres:5432 no Docker, localhost:5432 fora)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promouork

# -----------------------------------------------------------------------------
# Redis (compartilhado entre backend e Evolution API)
# Local: host=redis (nome do serviço no Docker) ou localhost fora do Docker
# Produção: use host do seu Redis (ex: redis, ou URL externa)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_2024
REDIS_IMAGE=redis:7.0

# -----------------------------------------------------------------------------
# Evolution API - Postgres (banco interno do Evolution/WhatsApp)
# -----------------------------------------------------------------------------
EVOLUTION_POSTGRES_USER=postgres
EVOLUTION_POSTGRES_PASSWORD=evolution_dev_2024
EVOLUTION_POSTGRES_DB=evolution_db
EVOLUTION_POSTGRES_PORT=5431

# -----------------------------------------------------------------------------
# Evolution API - Container (WhatsApp)
# Chave deve ser a mesma em AUTHENTICATION_API_KEY e no backend (EVOLUTION_API_KEY)
# -----------------------------------------------------------------------------
EVOLUTION_API_IMAGE=chat2one/sending2:v2.5.5
EVOLUTION_API_KEY=evolution_promouork_key
EVOLUTION_API_PORT=8081
EVOLUTION_API_SERVER_URL=http://localhost:8081
EVOLUTION_API_LOG_LEVEL=ERROR
EVOLUTION_API_LOG_COLOR=false
EVOLUTION_API_LOG_BAILEYS=error

# -----------------------------------------------------------------------------
# Backend (NestJS)
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production
PORT=3001

# -----------------------------------------------------------------------------
# Frontend (Next.js) - usado no build de produção
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.promouork.com.br

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (produção)
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Produção (opcional)
# -----------------------------------------------------------------------------
# NODE_OPTIONS=--max-old-space-size=2048
